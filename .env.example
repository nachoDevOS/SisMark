APP_NAME="SisMark"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Hora de Bolivia (UTC-4): el SIA y los biométricos guardan en hora local.
APP_TIMEZONE=America/La_Paz

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sismark
DB_USERNAME=root
DB_PASSWORD=

# SIA - SQL Server 2008 R2 remoto (encrypt=no obligatorio por TLS antiguo)
DB_HOST_SIA=
DB_PORT_SIA=1433
DB_DATABASE_SIA=SIA_DEV
DB_USERNAME_SIA=
DB_PASSWORD_SIA=
DB_ENCRYPT_SIA=no
DB_TRUST_SERVER_CERT_SIA=true
# Segundos de espera al abrir la conexión (el driver espera 15 s por defecto).
DB_LOGIN_TIMEOUT_SIA=3

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Microservicio de dispositivos (device-service Python)
DEVICE_SERVICE_URL=http://127.0.0.1:9001
DEVICE_SERVICE_TOKEN=

# API externa de Datos Personales «Mamoré» (solo lectura). URL con prefijo
# completo (…/api/personal) y su clave X-API-KEY.
MAMORE_API_URL=
MAMORE_API_KEY=

# Clave de NUESTRA API de asistencia (/api/v1/...), que consumen los sistemas
# externos para mostrarle a cada funcionario sus propias marcaciones. Es la
# contraparte de MAMORE_API_KEY: la misma clave va cargada en Mamoré.
# Vacía, la API rechaza todo con 503. Generar una larga y aleatoria:
#   php -r "echo bin2hex(random_bytes(32));"
SISMARK_API_KEY=
